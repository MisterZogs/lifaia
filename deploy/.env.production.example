# Lifaia — Variables d'environnement PRODUCTION
# NE PAS commiter ce fichier dans git

# --- DB (utilisé par docker-compose) ---
DB_PASSWORD=changeme

# --- Wasp ---
WASP_SERVER_URL=https://api.example.com
WASP_WEB_CLIENT_URL=https://example.com

# --- JWT ---
JWT_SECRET=changeme

# --- Admin ---
ADMIN_EMAILS=admin@example.com

# --- Emails transactionnels (Brevo SMTP) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=changeme
SMTP_PASSWORD=changeme

# --- Stripe (clés TEST — à remplacer par sk_live_ avant vrai lancement) ---
STRIPE_API_KEY=sk_test_changeme
STRIPE_WEBHOOK_SECRET=whsec_changeme
PAYMENTS_PREMIUM_SUBSCRIPTION_PLAN_ID=changeme
PAYMENTS_PREMIUM_ANNUEL_SUBSCRIPTION_PLAN_ID=changeme

# --- Placeholders paiements alternatifs ---
LEMONSQUEEZY_API_KEY=changeme
LEMONSQUEEZY_STORE_ID=changeme
LEMONSQUEEZY_WEBHOOK_SECRET=changeme
POLAR_ORGANIZATION_ACCESS_TOKEN=changeme
POLAR_WEBHOOK_SECRET=changeme
POLAR_SANDBOX_MODE=true

# --- Mistral ---
MISTRAL_API_KEY=changeme

# --- Analytics (non utilisé) ---
GOOGLE_ANALYTICS_CLIENT_EMAIL=changeme
GOOGLE_ANALYTICS_PRIVATE_KEY=changeme
GOOGLE_ANALYTICS_PROPERTY_ID=changeme

# --- Web Push (VAPID) ---
VAPID_PUBLIC_KEY=changeme
VAPID_PRIVATE_KEY=changeme
VAPID_EMAIL=admin@example.com

# --- DB URL explicite (pour Wasp) ---
DATABASE_URL=postgresql://user:changeme@host:5432/dbname
