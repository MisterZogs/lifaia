app MyDoctorIA {
  wasp: {
    version: "^0.22.0"
  },

  title: "Lifaia — Votre assistant santé personnel",

  head: [
    "<link rel='icon' href='/favicon.ico' />",

    "<meta name='description' content='Lifaia : assistant sante personnel base sur IA. Decrivez vos symptomes, gerez vos rappels medicaux et accedez a des informations sante personnalisees.' />",
    "<meta name='author' content='Lifaia' />",
    "<meta name='keywords' content='santé, assistant médical, symptômes, IA, bien-être, médecine, rappels médicaux' />",

    "<meta property='og:type' content='website' />",
    "<meta property='og:title' content='Lifaia — Votre assistant santé personnel' />",
    "<meta property='og:site_name' content='Lifaia' />",
    "<meta property='og:url' content='https://lifaia.com' />",
    "<meta property='og:description' content='Assistant sante personnel base sur IA. Information medicale personnalisee, rappels vaccins et medicaments.' />",
    "<meta property='og:image' content='https://lifaia.com/public-banner.webp' />",
    "<meta name='twitter:image' content='https://lifaia.com/public-banner.webp' />",
    "<meta name='twitter:image:width' content='800' />",
    "<meta name='twitter:image:height' content='400' />",
    "<meta name='twitter:card' content='summary_large_image' />",
  ],

  auth: {
    userEntity: User,
    methods: {
      email: {
        fromField: {
          name: "Lifaia",
          email: "noreply@lifaia.com"
        },
        emailVerification: {
          clientRoute: EmailVerificationRoute,
          getEmailContentFn: import { getVerificationEmailContent } from "@src/auth/email-and-pass/emails",
        },
        passwordReset: {
          clientRoute: PasswordResetRoute,
          getEmailContentFn: import { getPasswordResetEmailContent } from "@src/auth/email-and-pass/emails",
        },
        userSignupFields: import { getEmailUserFields } from "@src/auth/userSignupFields",
      },
    },
    onAuthFailedRedirectTo: "/login",
    // Après connexion, l'onboarding vérifie si le profil est déjà complété
    onAuthSucceededRedirectTo: "/onboarding",
  },

  db: {
    // Run `wasp db seed` to seed the database with the seed functions below:
    seeds: [
      // Populates the database with a bunch of fake users to work with during development.
      import { seedMockUsers } from "@src/server/scripts/dbSeeds",
      // Indexe les documents médicaux de référence pour le RAG (embeddings Mistral)
      import { seedDocumentsRAG } from "@src/rag/seedRAG",
    ]
  },

  client: {
    rootComponent: import App from "@src/client/App",
  },

  server: {
    envValidationSchema: import { serverEnvValidationSchema } from "@src/env",
  },

  emailSender: {
    // En prod : variables SMTP_HOST, SMTP_PORT, SMTP_USERNAME, SMTP_PASSWORD dans les vars d'env.
    // En dev local : mettre SMTP_HOST=localhost dans .env.server pour éviter les erreurs (emails ignorés).
    provider: SMTP,
    defaultFrom: {
      name: "Lifaia",
      email: "noreply@lifaia.com"
    },
  },
}

route LandingPageRoute { path: "/", to: LandingPage }
page LandingPage {
  component: import LandingPage from "@src/landing-page/LandingPage"
}

//#region Auth Pages
route LoginRoute { path: "/login", to: LoginPage }
page LoginPage {
  component: import Login from "@src/auth/LoginPage"
}

route SignupRoute { path: "/signup", to: SignupPage }
page SignupPage {
  component: import { Signup } from "@src/auth/SignupPage"
}

route RequestPasswordResetRoute { path: "/request-password-reset", to: RequestPasswordResetPage }
page RequestPasswordResetPage {
  component: import { RequestPasswordResetPage } from "@src/auth/email-and-pass/RequestPasswordResetPage",
}

route PasswordResetRoute { path: "/password-reset", to: PasswordResetPage }
page PasswordResetPage {
  component: import { PasswordResetPage } from "@src/auth/email-and-pass/PasswordResetPage",
}

route EmailVerificationRoute { path: "/email-verification", to: EmailVerificationPage }
page EmailVerificationPage {
  component: import { EmailVerificationPage } from "@src/auth/email-and-pass/EmailVerificationPage",
}
//#endregion

//#region User
route AccountRoute { path: "/account", to: AccountPage }
page AccountPage {
  authRequired: true,
  component: import Account from "@src/user/AccountPage"
}

query getPaginatedUsers {
  fn: import { getPaginatedUsers } from "@src/user/operations",
  entities: [User]
}

action updateIsUserAdminById {
  fn: import { updateIsUserAdminById } from "@src/user/operations",
  entities: [User]
}
//#endregion

//#region Onboarding patient
// Redirige ici après chaque connexion/inscription.
// Si l'onboarding est déjà complété, la page redirige vers /chat.
route OnboardingRoute { path: "/onboarding", to: OnboardingPage }
page OnboardingPage {
  authRequired: true,
  component: import OnboardingPage from "@src/onboarding/OnboardingPage"
}

// Action serveur pour persister le profil patient après l'onboarding
action completerOnboarding {
  fn: import { completerOnboarding } from "@src/patient/operations",
  entities: [User]
}

// Mise à jour du profil biologique (sexe, taille, poids, date de naissance)
action updateProfilUtilisateur {
  fn: import { updateProfilUtilisateur } from "@src/patient/operations",
  entities: [User]
}
//#endregion

//#region Enfants
// Opérations CRUD pour les profils enfants rattachés au compte parent

action ajouterEnfant {
  fn: import { ajouterEnfant } from "@src/enfant/operations",
  entities: [Enfant]
}

action modifierEnfant {
  fn: import { modifierEnfant } from "@src/enfant/operations",
  entities: [Enfant]
}

action supprimerEnfant {
  fn: import { supprimerEnfant } from "@src/enfant/operations",
  entities: [Enfant]
}

query getEnfants {
  fn: import { getEnfants } from "@src/enfant/operations",
  entities: [Enfant]
}
//#endregion

//#region Dossier médical
// Allergies
action ajouterAllergie {
  fn: import { ajouterAllergie } from "@src/dossierMedical/operations",
  entities: [Allergie]
}
action modifierAllergie {
  fn: import { modifierAllergie } from "@src/dossierMedical/operations",
  entities: [Allergie]
}
action supprimerAllergie {
  fn: import { supprimerAllergie } from "@src/dossierMedical/operations",
  entities: [Allergie]
}

// Traitements
action ajouterTraitement {
  fn: import { ajouterTraitement } from "@src/dossierMedical/operations",
  entities: [Traitement]
}
action modifierTraitement {
  fn: import { modifierTraitement } from "@src/dossierMedical/operations",
  entities: [Traitement]
}
action supprimerTraitement {
  fn: import { supprimerTraitement } from "@src/dossierMedical/operations",
  entities: [Traitement]
}

// Antécédents médicaux personnels
action ajouterAntecedent {
  fn: import { ajouterAntecedent } from "@src/dossierMedical/operations",
  entities: [AntecedentMedical]
}
action modifierAntecedent {
  fn: import { modifierAntecedent } from "@src/dossierMedical/operations",
  entities: [AntecedentMedical]
}
action supprimerAntecedent {
  fn: import { supprimerAntecedent } from "@src/dossierMedical/operations",
  entities: [AntecedentMedical]
}

// Antécédents familiaux
action ajouterAntecedentFamilial {
  fn: import { ajouterAntecedentFamilial } from "@src/dossierMedical/operations",
  entities: [AntecedentFamilial]
}
action modifierAntecedentFamilial {
  fn: import { modifierAntecedentFamilial } from "@src/dossierMedical/operations",
  entities: [AntecedentFamilial]
}
action supprimerAntecedentFamilial {
  fn: import { supprimerAntecedentFamilial } from "@src/dossierMedical/operations",
  entities: [AntecedentFamilial]
}

// Vaccinations
action ajouterVaccination {
  fn: import { ajouterVaccination } from "@src/dossierMedical/operations",
  entities: [Vaccination]
}
action modifierVaccination {
  fn: import { modifierVaccination } from "@src/dossierMedical/operations",
  entities: [Vaccination]
}
action supprimerVaccination {
  fn: import { supprimerVaccination } from "@src/dossierMedical/operations",
  entities: [Vaccination]
}

// Lecture du dossier complet (pour l'UI et le system prompt)
query getDossierMedical {
  fn: import { getDossierMedical } from "@src/dossierMedical/operations",
  entities: [Allergie, Traitement, AntecedentMedical, AntecedentFamilial, Vaccination]
}

route DossierMedicalRoute { path: "/dossier-medical", to: DossierMedicalPage }
page DossierMedicalPage {
  authRequired: true,
  component: import DossierMedicalPage from "@src/dossierMedical/DossierMedicalPage"
}
//#endregion

//#region Rappels médicaux
action ajouterRappel {
  fn: import { ajouterRappel } from "@src/rappels/operations",
  entities: [Rappel]
}
action modifierRappel {
  fn: import { modifierRappel } from "@src/rappels/operations",
  entities: [Rappel]
}
action supprimerRappel {
  fn: import { supprimerRappel } from "@src/rappels/operations",
  entities: [Rappel]
}
action marquerRappelFait {
  fn: import { marquerRappelFait } from "@src/rappels/operations",
  entities: [Rappel]
}

// Actions pour les notifications push Web Push API
action abonnerNotificationsPush {
  fn: import { abonnerNotificationsPush } from "@src/rappels/pushOperations",
  entities: [PushSubscription]
}

action desabonnerNotificationsPush {
  fn: import { desabonnerNotificationsPush } from "@src/rappels/pushOperations",
  entities: [PushSubscription]
}

query getRappels {
  fn: import { getRappels } from "@src/rappels/operations",
  entities: [Rappel]
}

route RappelsRoute { path: "/rappels", to: RappelsPage }
page RappelsPage {
  authRequired: true,
  component: import RappelsPage from "@src/rappels/RappelsPage"
}

job rappelsNotifJob {
  executor: PgBoss,
  perform: {
    fn: import { envoyerNotificationsRappels } from "@src/rappels/job"
  },
  schedule: {
    cron: "0 * * * *"
  },
  entities: [Rappel, User, PushSubscription]
}
//#endregion

//#region Chat médical — streaming SSE
// Namespace avec CORS explicite — obligatoire pour les api custom Wasp (pas de middleware par défaut)
// Sans ça, le preflight OPTIONS échoue → "Failed to fetch" côté client
apiNamespace chatApi {
  middlewareConfigFn: import { chatApiMiddlewareFn } from "@src/chat/streamHandler",
  path: "/api"
}

// Endpoint de streaming : retourne les tokens Mistral au fur et à mesure
api chatStream {
  fn: import { chatStreamHandler } from "@src/chat/streamHandler",
  auth: true,
  httpRoute: (POST, "/api/chat-stream")
}

//#region Chat médical
route ChatRoute { path: "/chat", to: ChatPage }
page ChatPage {
  authRequired: true,
  component: import ChatPage from "@src/chat/ChatPage"
}

// Envoi d'un message et réponse IA (inclut détection urgence + system prompt)
action envoyerMessage {
  fn: import { envoyerMessage } from "@src/chat/operations",
  entities: [User, MessageChat]
}

// Efface l'historique de conversation d'un onglet (bouton "Nouvelle conversation")
action effacerHistoriqueChat {
  fn: import { effacerHistoriqueChat } from "@src/chat/operations",
  entities: [MessageChat]
}

// Récupération de l'historique de conversation
query getHistoriqueChat {
  fn: import { getHistoriqueChat } from "@src/chat/operations",
  entities: [MessageChat]
}
//#endregion

//#region Payment
route PricingPageRoute { path: "/pricing", to: PricingPage }
page PricingPage {
  component: import PricingPage from "@src/payment/PricingPage"
}

route CheckoutResultRoute { path: "/checkout", to: CheckoutResultPage }
page CheckoutResultPage {
  authRequired: true,
  component: import CheckoutResultPage from "@src/payment/CheckoutResultPage"
}

query getCustomerPortalUrl {
  fn: import { getCustomerPortalUrl } from  "@src/payment/operations",
  entities: [User]
}

action generateCheckoutSession {
  fn: import { generateCheckoutSession } from "@src/payment/operations",
  entities: [User]
}

api paymentsWebhook {
  fn: import { paymentsWebhook } from "@src/payment/webhook",
  entities: [User],
  middlewareConfigFn: import { paymentsMiddlewareConfigFn } from "@src/payment/webhook",
  httpRoute: (POST, "/payments-webhook")
}
//#endregion

//#region Pages légales (mentions légales, CGU)
// Pages statiques accessibles sans connexion
route MentionsLegalesRoute { path: "/mentions-legales", to: MentionsLegalesPage }
page MentionsLegalesPage {
  component: import MentionsLegalesPage from "@src/legal/MentionsLegalesPage"
}

route CguRoute { path: "/cgu", to: CguPage }
page CguPage {
  component: import CguPage from "@src/legal/CguPage"
}
//#endregion

//#region Analytics
query getDailyStats {
  fn: import { getDailyStats } from "@src/analytics/operations",
  entities: [User, DailyStats]
}

job dailyStatsJob {
  executor: PgBoss,
  perform: {
    fn: import { calculateDailyStats } from "@src/analytics/stats"
  },
  schedule: {
    cron: "0 * * * *" // every hour. useful in production
    // cron: "* * * * *" // every minute. useful for debugging
  },
  entities: [User, DailyStats, Logs, PageViewSource]
}
//#endregion

//#region Admin Dashboard
route AdminRoute { path: "/admin", to: AnalyticsDashboardPage }
page AnalyticsDashboardPage {
  authRequired: true,
  component: import AnalyticsDashboardPage from "@src/admin/dashboards/analytics/AnalyticsDashboardPage"
}

route AdminUsersRoute { path: "/admin/users", to: AdminUsersPage }
page AdminUsersPage {
  authRequired: true,
  component: import AdminUsers from "@src/admin/dashboards/users/UsersDashboardPage"
}

route AdminSettingsRoute { path: "/admin/settings", to: AdminSettingsPage }
page AdminSettingsPage {
  authRequired: true,
  component: import AdminSettings from "@src/admin/elements/settings/SettingsPage"
}

route AdminCalendarRoute { path: "/admin/calendar", to: AdminCalendarPage }
page AdminCalendarPage {
  authRequired: true,
  component: import AdminCalendar from "@src/admin/elements/calendar/CalendarPage"
}


route AdminUIButtonsRoute { path: "/admin/ui/buttons", to: AdminUIButtonsPage }
page AdminUIButtonsPage {
  authRequired: true,
  component: import AdminUI from "@src/admin/elements/ui-elements/ButtonsPage"
}

route NotFoundRoute { path: "*", to: NotFoundPage }
page NotFoundPage {
  component: import { NotFoundPage } from "@src/client/components/NotFoundPage"
}
//#endregion

//#region Contact Form Messages
// TODO:
// add functionality to allow users to send messages to admin
// and make them accessible via the admin dashboard
route AdminMessagesRoute { path: "/admin/messages", to: AdminMessagesPage }
page AdminMessagesPage {
  authRequired: true,
  component: import AdminMessages from "@src/admin/dashboards/messages/MessagesPage"
}
//#endregion
